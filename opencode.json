{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },

  "lsp": true,
  "formatter": true,
  "snapshot": true,

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },

  "instructions": ["README.md", "AGENTS.md"],
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "claude": {
          "id": "kr/claude-sonnet-4.5",
          "name": "Claude Sonnet 4.5"
        },
        "glm": {
          "id": "kr/glm-5",
          "name": "GLM-5"
        },
        "haiku": {
          "id": "kr/claude-haiku-4.5",
          "name": "Claude Haiku 4.5"
        }
      }
    }
  }
}
