{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  },

  "lsp": true,
  "formatter": true,
  "snapshot": true,

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },

  "instructions": [
    "README.md",
    "AGENTS.md"
  ]
}