# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is the source of
# truth for which variables the app expects.
#
# Only variables prefixed EXPO_PUBLIC_ are inlined into the JS bundle by Expo.
# Never put a secret here — anything EXPO_PUBLIC_ is readable by anyone with
# the app.
# ---------------------------------------------------------------------------

# Base URL of the NestJS backend, WITHOUT the /v1 suffix. The axios client
# appends /v1 itself (URI versioning is enabled server-side).
# Android emulators reach the host machine at 10.0.2.2, not localhost.
# Production must be https:// (Android blocks cleartext HTTP in release builds).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Firebase project id for the NATIVE build. Must match all three of:
#   1. this value,
#   2. google-services.json  (Firebase console > Project settings > Your apps),
#   3. FIREBASE_PROJECT_ID in the backend's .env.
# Used as a build-time sanity check so a mismatch fails with a clear message
# instead of an opaque native FCM error.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Escape hatch for local development on an emulator/simulator, where a native
# push token cannot be obtained and getDevicePushTokenAsync() throws.
# Set to `false` to skip push registration entirely. Leave unset in real builds.
EXPO_PUBLIC_PUSH_ENABLED=true
