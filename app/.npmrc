# @react-native-community/datetimepicker declares `react-native-windows` as an
# OPTIONAL peer, so npm resolves it to whatever `*` happens to be latest (0.85.0)
# and then rejects the install because that package's own peer wants
# react-native ^0.85.0 while the project is on 0.88.0. It is a phantom
# dependency: this app builds for Android and iOS only, and nothing ever imports
# react-native-windows. Without this line `npm install` fails with ERESOLVE
# before installing anything, which is how the SDK 58 upgrade got stuck with an
# expo 58 CLI over an SDK 57 node_modules tree.
legacy-peer-deps=true
