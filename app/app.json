{
  "expo": {
    "name": "NNPU Academy",
    "slug": "nnpu",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/406be5d0-3cc0-4899-a4d6-ea0f4e1663d4"
    },
    "orientation": "portrait",
    "scheme": "nnpuacademy",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2D289C"
      },
      "package": "com.nnpu.app",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nnpu.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#332B92"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NNPU Academy to use your photos so you can set your profile picture.",
          "cameraPermission": "Allow NNPU Academy to use your camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "406be5d0-3cc0-4899-a4d6-ea0f4e1663d4"
      }
    },
    "owner": "punivijay"
  }
}
