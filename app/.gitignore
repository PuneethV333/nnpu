expo-env.d.ts
# @end expo-cli

.env

# Firebase config carries this project's project_id, storage bucket and
# project_number. Not a private key, but AGENTS.md commits to keeping these
# local — the pairing with iOS's GoogleService-Info.plist only earns a CI
# secrets pipeline on EAS Build or once a team shares them, and neither is
# true yet.
google-services.json
GoogleService-Info.plist