{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "scripts": {
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "test:backend": "npm --prefix backend test -- --silent",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:app": "npm --prefix app run typecheck",
    "typecheck:web": "npm --prefix web run typecheck",
    "dev:web": "npm --prefix web run dev"
  }
}
